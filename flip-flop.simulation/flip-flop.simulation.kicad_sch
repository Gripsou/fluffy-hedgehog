	(text_box "Results table :\n\n+-------+-------++------+-------+\n|  E1   |  E2   ||  A1  |   A2  |\n+=======+=======++======+=======+\n|   0   |   0   ||   α  |   α   |\n+-------+-------++------+-------+\n|   1   |   0   ||   0  |   β   |\n+-------+-------++------+-------+\n|   1   |   1   ||   0  |   0   |\n+-------+-------++------+-------+\n|   0   |   1   ||   β  |   0   |\n+-------+-------++------+-------+\n\n* Only if R_{1} = R_{2} = R_{3} = R_{4}\n* Where 0 and 1 are logic states i.e. 0 ~ 0V and 1 ~ V_{TTL}\n* Where V_{TTL} is the logic voltage applied at E_{1} and E_{2}\n\nAs a result :\n        V_{CC}     V_{TTL}\n* β = ----- + -----\n        2       2\n        V_{CC}\n* α = ----- \n        2\n"
		(exclude_from_sim no)
		(at 139.7 48.26 0)
		(size 55.88 53.34)
		(stroke
			(width 0)
			(type default)
		)
